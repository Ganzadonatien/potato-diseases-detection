rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Scan images - users can only read/write their own images
    match /scan_images/{userId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Profile images - users can only read/write their own profile images
    match /profile_images/{userId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
